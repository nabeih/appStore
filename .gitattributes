* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Source tests stay in Git; approved release archives omit development artifacts.
/tests export-ignore
/phpunit.xml export-ignore
/.phpunit.result.cache export-ignore
/.phpunit.cache export-ignore
/coverage export-ignore
/build/coverage export-ignore
/test-results export-ignore
/test-reports export-ignore
/playwright-report export-ignore
/phpunit-coverage export-ignore
/junit*.xml export-ignore
/coverage*.xml export-ignore
/test-results*.xml export-ignore
/clover.xml export-ignore
/cobertura.xml export-ignore
/coverage.txt export-ignore
/.nyc_output export-ignore
/build/logs export-ignore
/tmp export-ignore
/.env* export-ignore
/.env.example -export-ignore
/auth.json export-ignore
/storage/app/reports export-ignore
/storage/app/private export-ignore
/storage/app/public export-ignore
/storage/logs export-ignore
/storage/debugbar export-ignore
/storage/framework/testing export-ignore
/storage/framework/views export-ignore
/storage/framework/sessions export-ignore
/storage/framework/cache export-ignore
/bootstrap/cache/*.php export-ignore
/public/storage export-ignore
