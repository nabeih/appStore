# Template only. Preserve the existing production APP_KEY; never use test keys.
APP_NAME="appStore"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-with-approved-subdomain.example
APP_LOCALE=ar
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_APPROVED_DATABASE
